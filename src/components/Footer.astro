---
import { SITE, NAV } from '../site.config';
import Wordmark from './Wordmark.astro';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="footer-name" role="img" aria-label={SITE.name}><Wordmark /></div>
        <p>{SITE.description}</p>
        <p>Independent. Supported by affiliate links and clearly labelled advertising. <a href="/disclosure/">See our disclosure.</a></p>
      </div>
      <div>
        <ul>
          {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/newsletter/">Newsletter</a></li>
        </ul>
      </div>
      <div>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/how-we-review/">How we evaluate</a></li>
          <li><a href="/submit/">Submit a platform</a></li>
          <li><a href="/disclosure/">Disclosure</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/search/">Search</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
    </div>
    <p class="footer-small">© {new Date().getFullYear()} {SITE.name}.</p>
  </div>
</footer>
