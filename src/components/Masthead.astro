---
// The marigold masthead (v2). `full` (home, hubs and section pages): search left, wordmark and motto
// centred, tools right, then the main navigation as a rail of five entry points, Intelligence last
// as the members' ink tab. `slim` (articles): wordmark left, the five sections right.
// Pages can continue the band below it with <div class="band">…</div> (the home lead story, an article's head).
// The compact bar slides in once the masthead has scrolled away (script in Base.astro).
import { SITE, NAV, navKeyFor } from '../site.config';
import Wordmark from './Wordmark.astro';

interface Props { current?: string; variant?: 'full' | 'slim' }
const { current, variant = 'full' } = Astro.props;
const active = navKeyFor(current);
const searchIcon = '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.6-4.6"/>';
---

<header class={`masthead band masthead-${variant}`}>
  <div class="wrap">
    <div class="mh-top">
      {variant === 'full' && (
        <form class="mh-search" role="search" action="/search/" method="get">
          <label class="visually-hidden" for="mh-q">Search</label>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={searchIcon} />
          <input id="mh-q" name="q" type="search" placeholder="Search articles, products, vendors and reports" autocomplete="off" />
        </form>
      )}
      <div class="mh-brand">
        <a class="mh-wordmark" href="/" aria-label={`${SITE.name} home`}><Wordmark compact={variant === 'slim'} /></a>
        {variant === 'full' && <p class="mh-motto">{SITE.motto}</p>}
      </div>
      <div class="mh-tools">
        {variant === 'slim' && (
          <nav class="mh-sections" aria-label="Main">
            {NAV.map((n) => <a href={n.href} class={'members' in n ? 'is-members' : undefined} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>)}
          </nav>
        )}
        {variant === 'slim' && (
          <a class="icon-btn" href="/search/" aria-label="Search" title="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={searchIcon} />
          </a>
        )}
        {variant === 'full' && (
          <a class="icon-btn mh-search-icon" href="/search/" aria-label="Search" title="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={searchIcon} />
          </a>
        )}
        <button type="button" class="icon-btn theme-toggle" aria-label="Switch colour theme" title="Switch colour theme">
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <a class="mh-pill" href="/newsletter/" aria-current={current === 'newsletter' ? 'page' : undefined}>Get the newsletter</a>
      </div>
    </div>

    {variant === 'full' && (
      <nav class="mh-nav" aria-label="Main">
        {NAV.map((n) => (
          <a href={n.href} class={'members' in n ? 'is-members' : undefined} aria-current={active === n.key ? 'page' : undefined}>
            <span class="mh-nav-label"><b>{n.label}</b>{'members' in n && <span class="members-tag">Members</span>}</span>
            <i>{n.note}</i>
          </a>
        ))}
      </nav>
    )}

    <nav class={`mh-strip ${variant === 'slim' ? 'is-slim' : ''}`} aria-label="Main (compact)">
      {NAV.map((n) => <a href={n.href} class={'members' in n ? 'is-members' : undefined} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>)}
    </nav>
  </div>
</header>

<div class="compact-bar band" aria-hidden="true">
  <div class="wrap compact-inner">
    <a class="compact-wordmark" href="/" tabindex="-1" aria-label={SITE.name}><Wordmark compact /></a>
    <div class="compact-links">
      {NAV.map((n) => <a href={n.href} class={'members' in n ? 'is-members' : undefined} tabindex="-1">{n.label}</a>)}
    </div>
    <form class="compact-search" role="search" action="/search/" method="get">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={searchIcon} />
      <input name="q" type="search" placeholder="Search" tabindex="-1" autocomplete="off" aria-label="Search" />
    </form>
    <a class="icon-btn compact-search-icon" href="/search/" tabindex="-1" aria-label="Search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={searchIcon} />
    </a>
  </div>
</div>
