---
import { SITE, SECTIONS } from '../site.config';
import Wordmark from './Wordmark.astro';

interface Props { current?: string }
const { current } = Astro.props;
const today = new Intl.DateTimeFormat('en-AU', {
  timeZone: SITE.timezone, weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
}).format(new Date());
const links = [
  ...Object.entries(SECTIONS).map(([key, s]) => ({ href: `/${key}/`, label: s.label, key })),
  { href: '/newsletter/', label: 'Newsletter', key: 'newsletter' },
];
---

<header class="masthead">
  <div class="wrap">
    <div class="masthead-top">
      <span data-today>{today}</span>
      <span class="tagline">{SITE.tagline}</span>
    </div>
    <a class="masthead-wordmark" href="/" aria-label={`${SITE.name} home`}><Wordmark /></a>
    <div class="masthead-rules" aria-hidden="true"></div>
    <nav class="masthead-nav" aria-label="Sections">
      <span class="nav-spacer" aria-hidden="true"></span>
      <div class="nav-links">
        {links.map((l) => <a href={l.href} class={`nav-${l.key}`} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>)}
      </div>
      <div class="nav-tools">
        <a class="icon-btn" href="/search/" aria-label="Search" title="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.6-4.6"/></svg>
        </a>
        <button type="button" class="icon-btn theme-toggle" aria-label="Switch colour theme" title="Switch colour theme">
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<div class="compact-bar" aria-hidden="true">
  <div class="wrap compact-inner">
    <a class="compact-wordmark" href="/" tabindex="-1" aria-label={SITE.name}><Wordmark /></a>
    <div class="nav-links">
      {links.map((l) => <a href={l.href} tabindex="-1">{l.label}</a>)}
    </div>
    <div class="nav-tools">
      <a class="icon-btn" href="/search/" tabindex="-1" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.6-4.6"/></svg>
      </a>
    </div>
  </div>
</div>
