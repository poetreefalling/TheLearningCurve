---
// Newsletter sign-up. Posts to /api/subscribe (functions/api/subscribe.ts), which adds the reader
// to Beehiiv. Works without JavaScript; with it, the form submits in place.
import { SITE } from '../site.config';
interface Props { placement?: string }
const { placement = 'site' } = Astro.props;
const on = SITE.newsletter !== null;
const id = `nl-${placement}`;
---
<form class="nl-form-wrap" method="post" action="/api/subscribe" data-newsletter>
  <input type="hidden" name="placement" value={placement} />
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <div class="nl-hp" aria-hidden="true"><label>Company <input name="company" tabindex="-1" autocomplete="off" /></label></div>
  <div class="nl-form">
    <label class="visually-hidden" for={`${id}-email`}>Email address</label>
    <input id={`${id}-email`} name="email" type="email" placeholder="you@example.com" autocomplete="email" required disabled={!on} />
    <button class="button" type="submit" disabled={!on}>{on ? 'Subscribe' : 'Coming soon'}</button>
  </div>
  {on && (
    <label class="nl-optin">
      <input type="checkbox" name="credentialcraft" value="yes" />
      <span>Also send me occasional updates from CredentialCraft, the course-design studio run by our founder.</span>
    </label>
  )}
  <div class="nl-done" hidden tabindex="-1">
    <p class="nl-done-title">You're subscribed.</p>
    <p class="nl-done-text">We've sent a welcome email to <strong data-nl-email></strong>. If it isn't in your inbox in a few minutes, check your spam or promotions folder.</p>
    <p class="nl-done-text" data-nl-cc hidden>You'll also get occasional updates from CredentialCraft.</p>
    <button type="button" class="nl-again">Use a different address</button>
  </div>
  <p class="nl-note" role="status" aria-live="polite">
    {on ? <>Free, once a month. Unsubscribe any time. <a href="/disclosure/#email">How we handle your email</a>.</> : 'The monthly newsletter opens soon.'}
  </p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    if (form.dataset.bound) return;
    form.dataset.bound = '1';
    const note = form.querySelector<HTMLElement>('.nl-note')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const emailInput = form.querySelector<HTMLInputElement>('input[type=email]')!;
    const fields = form.querySelectorAll<HTMLElement>('.nl-form, .nl-optin');
    const done = form.querySelector<HTMLElement>('.nl-done')!;
    const defaultNote = note.innerHTML;

    const showForm = () => {
      done.hidden = true;
      fields.forEach((el) => (el.hidden = false));
      note.hidden = false;
      note.innerHTML = defaultNote;
      note.classList.remove('nl-error');
      emailInput.focus();
    };
    done.querySelector('.nl-again')!.addEventListener('click', showForm);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = Object.fromEntries(new FormData(form).entries());
      button.disabled = true;
      note.classList.remove('nl-error');
      note.textContent = 'Subscribing…';
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        const json = await res.json().catch(() => ({ message: 'Something went wrong. Please try again.' }));
        if (res.ok) {
          done.querySelector<HTMLElement>('[data-nl-email]')!.textContent = String(body.email ?? '').trim();
          done.querySelector<HTMLElement>('[data-nl-cc]')!.hidden = body.credentialcraft !== 'yes';
          fields.forEach((el) => (el.hidden = true));
          note.hidden = true;
          done.hidden = false;
          done.focus();
          emailInput.value = '';
        } else {
          note.textContent = json.message;
          note.classList.add('nl-error');
        }
      } catch {
        note.textContent = 'Something went wrong. Please try again.';
        note.classList.add('nl-error');
      }
      button.disabled = false;
    });
  });
</script>
