---
// Share links for an article: LinkedIn, Facebook, X, Bluesky, email, copy link, and the phone's
// own share sheet where the browser offers one. Plain links, no third-party scripts or trackers.
interface Props {
  url: string;
  title: string;
  summary: string;
  placement: 'top' | 'end';
}
const { url, title, summary, placement } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const links = [
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { label: 'X', href: `https://x.com/intent/post?text=${t}&url=${u}` },
  { label: 'Bluesky', href: `https://bsky.app/intent/compose?text=${encodeURIComponent(`${title} ${url}`)}` },
];
const mail = `mailto:?subject=${t}&body=${encodeURIComponent(`${summary}\n\n${url}`)}`;
---

<div class={`share share-${placement}`} data-pagefind-ignore data-share-url={url} data-share-title={title}>
  {placement === 'end' && <p class="share-lead">Found this useful? Share it with someone who builds courses.</p>}
  <div class="share-row" role="group" aria-label="Share this article">
    <span class="share-label">Share</span>
    <button type="button" class="share-btn share-native" hidden>Share…</button>
    {links.map((l) => (
      <a class="share-btn" href={l.href} target="_blank" rel="noopener" aria-label={`Share on ${l.label} (opens in a new tab)`}>{l.label}</a>
    ))}
    <a class="share-btn" href={mail}>Email</a>
    <button type="button" class="share-btn share-copy">Copy link</button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.share').forEach((box) => {
    const url = box.dataset.shareUrl!;
    const title = box.dataset.shareTitle!;
    const native = box.querySelector<HTMLButtonElement>('.share-native')!;
    if (navigator.share) {
      native.hidden = false;
      native.addEventListener('click', () => navigator.share({ title, url }).catch(() => {}));
    }
    const copy = box.querySelector<HTMLButtonElement>('.share-copy')!;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        copy.textContent = 'Link copied';
      } catch {
        window.prompt('Copy this link:', url);
      }
      setTimeout(() => (copy.textContent = 'Copy link'), 2000);
    });
  });
</script>

<style>
  .share { font: 500 14px/1.3 var(--sans); }
  .share-top { margin-top: 18px; }
  .share-end { margin: 48px auto 0; padding: 22px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .share-lead { font: 600 1.05rem/1.4 var(--serif); margin: 0 0 12px; color: var(--ink); }
  .share-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .share-label { color: var(--muted); margin-right: 4px; }
  .share-btn {
    font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--rule);
    border-radius: 999px; padding: 7px 14px; text-decoration: none; cursor: pointer; line-height: 1.2;
  }
  .share-btn:hover { border-color: var(--ink); }
  .share-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .share-native { background: var(--accent); border-color: var(--accent); color: var(--paper); }
  .share-native[hidden] { display: none; }
</style>
