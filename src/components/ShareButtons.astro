---
// Share links for an article: LinkedIn, Facebook, X, Bluesky, email, copy link, and the phone's
// own share sheet where the browser offers one. Plain links, no third-party scripts or trackers.
interface Props {
  url: string;
  title: string;
  summary: string;
  placement: 'top' | 'end';
}
import { siLinkedin, siFacebook, siX, siBluesky } from 'simple-icons';
const { url, title, summary, placement } = Astro.props;
// Generic icons (24×24, stroked) for the non-brand buttons
const ICON = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  link: '<path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1"/><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/>',
  share: '<path d="M12 3v12"/><path d="m7 8 5-5 5 5"/><path d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"/>',
};
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const links = [
  { label: 'LinkedIn', icon: siLinkedin, href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  { label: 'Facebook', icon: siFacebook, href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { label: 'X', icon: siX, href: `https://x.com/intent/post?text=${t}&url=${u}` },
  { label: 'Bluesky', icon: siBluesky, href: `https://bsky.app/intent/compose?text=${encodeURIComponent(`${title} ${url}`)}` },
];
const mail = `mailto:?subject=${t}&body=${encodeURIComponent(`${summary}\n\n${url}`)}`;
---

<div class={`share share-${placement}`} data-pagefind-ignore data-share-url={url} data-share-title={title}>
  {placement === 'end' && <p class="share-lead">Found this useful? Share it with someone who builds courses.</p>}
  <div class="share-row" role="group" aria-label="Share this article">
    <span class="share-label">Share</span>
    <button type="button" class="share-btn share-native" hidden>
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.share} /><span>Share…</span>
    </button>
    {links.map((l) => (
      <a class="share-btn" href={l.href} target="_blank" rel="noopener" aria-label={`Share on ${l.label} (opens in a new tab)`} style={`--brand:#${l.icon.hex}`}>
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d={l.icon.path} /></svg><span class="txt">{l.label}</span>
      </a>
    ))}
    <a class="share-btn" href={mail} aria-label="Share by email">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.mail} /><span class="txt">Email</span>
    </a>
    <button type="button" class="share-btn share-copy" aria-label="Copy link">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.link} /><span class="txt copy-txt">Copy link</span>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.share').forEach((box) => {
    const url = box.dataset.shareUrl!;
    const title = box.dataset.shareTitle!;
    const native = box.querySelector<HTMLButtonElement>('.share-native')!;
    if (navigator.share) {
      native.hidden = false;
      native.addEventListener('click', () => navigator.share({ title, url }).catch(() => {}));
    }
    const copy = box.querySelector<HTMLButtonElement>('.share-copy')!;
    const txt = copy.querySelector<HTMLElement>('.copy-txt')!;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        txt.textContent = 'Link copied';
      } catch {
        window.prompt('Copy this link:', url);
      }
      setTimeout(() => (txt.textContent = 'Copy link'), 2000);
    });
  });
</script>

<style>
  .share { font: 500 14px/1.3 var(--sans); }
  .share-top { margin-top: 18px; }
  .share-end { margin: 48px auto 0; padding: 22px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .share-lead { font: 600 1.05rem/1.4 var(--serif); margin: 0 0 12px; color: var(--ink); }
  .share-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .share-label { color: var(--muted); margin-right: 4px; }
  .share-btn {
    font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--rule);
    border-radius: 999px; padding: 7px 14px 7px 11px; text-decoration: none; cursor: pointer; line-height: 1.2;
    display: inline-flex; align-items: center; gap: 7px;
  }
  .ico { width: 16px; height: 16px; flex: none; }
  .share-btn:hover { border-color: var(--ink); }
  .share-btn[style]:hover .ico { color: var(--brand); }
  :global(:root[data-theme='dark']) .share-btn[style*='#000000']:hover .ico { color: var(--ink); }
  @media (prefers-color-scheme: dark) { .share-btn[style*='#000000']:hover .ico { color: var(--ink); } }
  /* Top row on phones: icons only, to keep it to one line */
  @media (max-width: 560px) {
    .share-top .txt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .share-top .share-btn { padding: 9px; }
  }
  .share-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .share-native { background: var(--accent); border-color: var(--accent); color: var(--paper); }
  .share-native[hidden] { display: none; }
</style>
