---
// <DotField value={4393} label="…" title="…" source="…" href="…" compare={{ title, text }} />:
// one dot per item, filling in as the figure scrolls into view, so a big count is felt rather
// than read. The number is plain text in the page (and in the source line), so it reads the same
// with no JavaScript. `compare` adds a small panel beside it for a contrast that has no count.
interface Props {
  value: number;
  label: string;
  title: string;
  sub?: string;
  source: string;
  href?: string;
  compare?: { title: string; text: string };
}
const { value, label, title, sub, source, href, compare } = Astro.props;
const shown = value.toLocaleString('en-AU');
---

<figure class="fw fw-dots" data-dot-field data-value={value} data-pagefind-ignore>
  <div class="fw-label">By the numbers</div>
  <h3 class="fw-title">{title}</h3>
  {sub && <p class="fw-sub">{sub}</p>}
  <div class:list={['df-grid', { 'df-two': compare }]}>
    <div class="df-panel">
      <canvas class="df-canvas" width="640" height="300" role="img" aria-label={`${shown} dots, one for each: ${label}`}></canvas>
      <p class="df-count"><span data-df-n>{shown}</span> <span class="df-label">{label}</span></p>
    </div>
    {compare && (
      <div class="df-panel df-compare">
        <svg class="df-table" viewBox="0 0 240 170" aria-hidden="true">
          <ellipse cx="120" cy="85" rx="66" ry="38" class="df-tbl" />
          {Array.from({ length: 10 }, (_, i) => {
            const t = (i / 10) * Math.PI * 2;
            return <circle class="df-seat" cx={120 + Math.cos(t) * 92} cy={85 + Math.sin(t) * 62} r="10" style={`--d:${i}`} />;
          })}
        </svg>
        <p class="df-ctitle">{compare.title}</p>
        <p class="df-ctext">{compare.text}</p>
      </div>
    )}
  </div>
  <figcaption class="fw-note">Source: {href ? <a href={href}>{source}</a> : source}</figcaption>
</figure>

<style>
  .fw-dots .df-grid { display: grid; gap: 16px; margin-top: 16px; }
  .fw-dots .df-two { grid-template-columns: 1.6fr 1fr; }
  @media (max-width: 640px) { .fw-dots .df-two { grid-template-columns: 1fr; } }
  .fw-dots .df-panel { background: var(--paper); padding: 12px; }
  .fw-dots .df-canvas { width: 100%; height: auto; display: block; }
  .fw-dots .df-count { margin: 10px 0 0; font: 600 2rem/1 var(--display); color: var(--ink); font-variant-numeric: tabular-nums; }
  .fw-dots .df-label { font: 400 14px/1.4 var(--sans); color: var(--muted); }
  .fw-dots .df-compare { display: flex; flex-direction: column; justify-content: center; }
  .fw-dots .df-table { width: 100%; max-width: 230px; margin: 0 auto; display: block; }
  .fw-dots .df-tbl { fill: var(--ink); }
  .fw-dots .df-seat { fill: var(--band); }
  .fw-dots .df-seat:nth-of-type(3n) { fill: var(--kicker); }
  .fw-dots .df-ctitle { font: 600 1.05rem/1.3 var(--display); margin: 10px 0 2px; color: var(--ink); }
  .fw-dots .df-ctext { font: 400 14px/1.45 var(--sans); color: var(--ink-2); margin: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .fw-dots.df-js .df-seat { opacity: 0; transition: opacity 0.4s calc(600ms + var(--d) * 140ms); }
    .fw-dots.df-js.df-on .df-seat { opacity: 1; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const css = (el: Element, name: string) => getComputedStyle(el).getPropertyValue(name).trim();
  for (const root of document.querySelectorAll<HTMLElement>('[data-dot-field]')) {
    const N = Number(root.dataset.value);
    const cv = root.querySelector<HTMLCanvasElement>('canvas')!;
    const out = root.querySelector<HTMLElement>('[data-df-n]')!;
    const ctx = cv.getContext('2d');
    if (!ctx || !N) continue;
    const W = cv.width, H = cv.height;
    const cols = Math.ceil(Math.sqrt((N * W) / H)), rows = Math.ceil(N / cols);
    const cw = W / cols, ch = H / rows, r = Math.max(1, Math.min(cw, ch) * 0.36);
    const order = Array.from({ length: N }, (_, i) => i);
    let seed = 7;
    const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
    for (let i = N - 1; i > 0; i--) { const j = Math.floor(rand() * (i + 1)); [order[i], order[j]] = [order[j], order[i]]; }
    const band = css(root, '--band') || '#f6c847', kick = css(root, '--kicker') || '#c0391b';
    const dot = (k: number) => {
      ctx.fillStyle = (Math.imul(k, 2654435761) >>> 0) % 11 === 0 ? kick : band;
      ctx.beginPath();
      ctx.arc((k % cols + 0.5) * cw, (Math.floor(k / cols) + 0.5) * ch, r, 0, Math.PI * 2);
      ctx.fill();
    };
    const all = () => { for (let i = 0; i < N; i++) dot(order[i]); };
    if (reduce || !('IntersectionObserver' in window)) { all(); continue; }
    root.classList.add('df-js');
    out.textContent = '0';
    const io = new IntersectionObserver((es) => {
      if (!es.some((e) => e.isIntersecting)) return;
      io.disconnect();
      root.classList.add('df-on');
      let drawn = 0;
      const t0 = performance.now(), ms = 2200;
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / ms), target = Math.floor(N * (1 - (1 - p) ** 2));
        for (; drawn < target; drawn++) dot(order[drawn]);
        out.textContent = drawn.toLocaleString('en-AU');
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }, { threshold: 0.3 });
    io.observe(root);
  }
</script>
