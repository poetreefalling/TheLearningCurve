---
// <EvidenceMap id="learning-paradox" /> — the sources behind a feature, from
// src/data/evidence/<id>.json, grouped into clusters. Each source chip opens its entry (method, the
// finding we used, its limits, a link). Text can link to an entry with #ev-<source id>.
// Without JavaScript the chips are anchor links and every entry is a <details> element.
import { getEntry } from 'astro:content';
interface Props { id: string }
const entry = await getEntry('evidence', Astro.props.id);
if (!entry) throw new Error(`EvidenceMap: no src/data/evidence/${Astro.props.id}.json`);
const m = entry.data;
const ids = Object.keys(m.sources);
const clustersOf = (s: string) => m.clusters.filter((c) => c.sources.includes(s)).map((c) => c.name);
---

<section class="fw fw-evidence" data-evidence-map aria-labelledby={`ev-${Astro.props.id}-h`} data-pagefind-ignore>
  <div class="fw-label">Evidence map</div>
  <h3 class="fw-title" id={`ev-${Astro.props.id}-h`}>{m.title}</h3>
  <p class="fw-sub">{m.intro}</p>

  <ol class="ev-clusters">
    {m.clusters.map((c, i) => (
      <li class="ev-cluster" data-cluster={c.id}>
        <div class="ev-num">{i + 1}</div>
        <div class="ev-body">
          <h4 class="ev-name">{c.name}</h4>
          <p class="ev-q">{c.question}</p>
          <ul class="ev-chips">
            {c.sources.map((s) => (
              <li><a class="ev-chip" href={`#ev-${s}`} data-source={s}>{m.sources[s].publisher}</a></li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>

  <div class="ev-entries">
    {ids.map((s) => {
      const src = m.sources[s];
      return (
        <details class="ev-entry" id={`ev-${s}`} data-entry={s}>
          <summary>
            <span class="ev-entry-name">{src.name}</span>
            <span class="ev-entry-meta">{src.publisher} · {src.date} · {src.type}</span>
          </summary>
          <dl>
            <dt>How it was done</dt><dd>{src.method}</dd>
            <dt>What we used</dt><dd><ul>{src.findings.map((f) => <li>{f}</li>)}</ul></dd>
            <dt>Limits</dt><dd>{src.limits}</dd>
            <dt>Clusters</dt><dd>{clustersOf(s).join(' · ')}</dd>
          </dl>
          <p class="ev-link"><a href={src.url} rel="noopener">Read the original</a></p>
        </details>
      );
    })}
  </div>
</section>

<style>
  .fw .ev-clusters { list-style: none; padding: 0; margin: 18px 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .fw .ev-cluster { display: grid; grid-template-columns: 28px 1fr; gap: 10px; padding: 12px; border: 1px solid var(--rule); background: var(--paper); transition: border-color 0.2s; }
  .fw .ev-cluster.is-lit { border-color: var(--accent); }
  .fw .ev-num { font: 600 13px/28px var(--sans); text-align: center; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); color: var(--paper); }
  .fw .ev-name { font: 600 15px/1.3 var(--sans); margin: 3px 0 4px; color: var(--ink); }
  .fw .ev-q { font: 400 13.5px/1.45 var(--sans); color: var(--muted); margin: 0 0 8px; }
  .fw .ev-chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .fw .ev-chips li { margin: 0; }
  .fw .prose .ev-chip, .fw .ev-chip { display: inline-block; font: 500 12.5px/1 var(--sans); color: var(--ink); text-decoration: none; background: var(--surface); border: 1px solid var(--rule); padding: 7px 9px; }
  .fw .ev-chip:hover, .fw .ev-chip.is-on { border-color: var(--accent); color: var(--accent); }
  .fw .ev-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .fw .ev-entries { margin-top: 18px; border-top: 1px solid var(--rule); }
  .fw .ev-entry { border-bottom: 1px solid var(--rule); scroll-margin-top: 80px; }
  .fw .ev-entry summary { cursor: pointer; padding: 12px 30px 12px 0; list-style: none; display: grid; gap: 3px; position: relative; }
  .fw .ev-entry summary::-webkit-details-marker { display: none; }
  .fw .ev-entry summary::after { content: '+'; position: absolute; right: 4px; top: 13px; font: 400 20px/1 var(--sans); color: var(--muted); }
  .fw .ev-entry[open] summary::after { content: '−'; }
  .fw .ev-entry-name { font: 600 15px/1.35 var(--sans); color: var(--ink); }
  .fw .ev-entry-meta { font: 400 12.5px/1.4 var(--sans); color: var(--muted); }
  .fw .ev-entry:target, .fw .ev-entry.is-flash { background: var(--highlight); transition: background 1.2s; }
  .fw .ev-entry dl { margin: 0 0 8px; font: 400 14.5px/1.5 var(--sans); color: var(--ink-2); }
  .fw .ev-entry dt { font: 600 11px/1 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-top: 12px; }
  .fw .ev-entry dd { margin: 5px 0 0; }
  .fw .ev-entry dd ul { margin: 0; padding-left: 1.1em; }
  .fw .ev-entry dd li { margin: 3px 0; }
  .fw .ev-link { font: 500 14px/1.4 var(--sans); margin: 4px 0 14px; }
  @media (max-width: 640px) { .fw .ev-clusters { grid-template-columns: 1fr; } }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-evidence-map]')) {
    const entries = new Map<string, HTMLDetailsElement>();
    root.querySelectorAll<HTMLDetailsElement>('[data-entry]').forEach((d) => entries.set(d.dataset.entry!, d));
    const chips = [...root.querySelectorAll<HTMLAnchorElement>('[data-source]')];
    const clusters = [...root.querySelectorAll<HTMLElement>('[data-cluster]')];

    const light = (src: string | null) => {
      chips.forEach((c) => c.classList.toggle('is-on', c.dataset.source === src));
      clusters.forEach((c) => c.classList.toggle('is-lit', !!src && !!c.querySelector(`[data-source="${src}"]`)));
    };
    const open = (src: string, scroll: boolean) => {
      const d = entries.get(src);
      if (!d) return;
      d.open = true;
      light(src);
      d.classList.remove('is-flash');
      void d.offsetWidth;
      d.classList.add('is-flash');
      setTimeout(() => d.classList.remove('is-flash'), 1600);
      if (scroll) d.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      d.querySelector('summary')?.focus({ preventScroll: true });
    };

    chips.forEach((c) => c.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', `#ev-${c.dataset.source}`);
      open(c.dataset.source!, true);
    }));
    entries.forEach((d, src) => d.addEventListener('toggle', () => { if (d.open) light(src); }));

    // Links anywhere in the article (href="#ev-…") open the matching entry
    const fromHash = () => {
      const m = location.hash.match(/^#ev-(.+)$/);
      if (m && entries.has(m[1])) open(m[1], true);
    };
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest?.('a[href^="#ev-"]') as HTMLAnchorElement | null;
      if (!a || root.contains(a)) return;
      const src = a.getAttribute('href')!.slice(4);
      if (!entries.has(src)) return;
      e.preventDefault();
      history.replaceState(null, '', `#ev-${src}`);
      open(src, true);
    });
    window.addEventListener('hashchange', fromHash);
    fromHash();
  }
</script>
