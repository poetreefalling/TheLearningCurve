---
// <ListeningLoop title="…" steps={[{ label, text }, …]} />: a cycle of three to five steps drawn
// as a ring. It steps round on its own once it scrolls into view (unless the reader prefers
// reduced motion), and readers can tap any step. It shows our own way of working, not a finding,
// and its label says so. With no JavaScript, every step is listed in full.
interface Step { label: string; text: string }
interface Props { title: string; sub?: string; centre?: string; steps: Step[]; note?: string }
const { title, sub, centre = 'Listen', steps, note = 'Our working method, drawn from the practice described in this article. Not a research finding.' } = Astro.props;
const n = steps.length;
const R = 100, C = 130, gap = 0.07;
const arcs = steps.map((s, i) => {
  const a0 = -Math.PI / 2 + (i * 2 * Math.PI) / n + gap;
  const a1 = -Math.PI / 2 + ((i + 1) * 2 * Math.PI) / n - gap;
  const am = (a0 + a1) / 2;
  const large = a1 - a0 > Math.PI ? 1 : 0;
  return {
    d: `M ${C + R * Math.cos(a0)} ${C + R * Math.sin(a0)} A ${R} ${R} 0 ${large} 1 ${C + R * Math.cos(a1)} ${C + R * Math.sin(a1)}`,
    tx: C + (R + 30) * Math.cos(am),
    ty: C + (R + 30) * Math.sin(am) + 4,
    label: s.label,
  };
});
---

<figure class="fw fw-loop" data-listening-loop data-pagefind-ignore>
  <div class="fw-label">How we'd do it</div>
  <h3 class="fw-title">{title}</h3>
  {sub && <p class="fw-sub">{sub}</p>}
  <div class="ll-wrap">
    <svg class="ll-ring" viewBox="-10 -10 280 280" aria-hidden="true">
      {arcs.map((a, i) => <path class="ll-seg" data-i={i} d={a.d} />)}
      {arcs.map((a) => <text class="ll-lab" x={a.tx} y={a.ty} text-anchor="middle">{a.label}</text>)}
      <text class="ll-ctr" x="130" y="136" text-anchor="middle">{centre}</text>
    </svg>
    <div class="ll-copy">
      <div class="ll-tabs" role="tablist" hidden>
        {steps.map((s, i) => <button type="button" role="tab" data-i={i}>{i + 1}. {s.label}</button>)}
      </div>
      <ol class="ll-steps">
        {steps.map((s, i) => (
          <li class="ll-step" data-i={i}>
            <span class="ll-h">{i + 1}. {s.label}</span>
            <span class="ll-t">{s.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <figcaption class="fw-note">{note}</figcaption>
</figure>

<style>
  .fw-loop .ll-wrap { display: grid; grid-template-columns: 240px 1fr; gap: 22px; align-items: center; margin-top: 14px; }
  @media (max-width: 600px) { .fw-loop .ll-wrap { grid-template-columns: 1fr; } .fw-loop .ll-ring { max-width: 240px; margin: 0 auto; } }
  .fw-loop .ll-ring { width: 100%; display: block; }
  .fw-loop .ll-seg { fill: none; stroke: var(--band); stroke-width: 22; transition: stroke 0.4s, opacity 0.4s; }
  .fw-loop .ll-lab { font: 700 11px var(--label); letter-spacing: 0.06em; text-transform: uppercase; fill: var(--ink); }
  .fw-loop .ll-ctr { font: 600 22px var(--display); fill: var(--ink); }
  .fw-loop .ll-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .fw-loop .ll-h { display: block; font: 600 1.05rem/1.3 var(--display); color: var(--ink); }
  .fw-loop .ll-t { display: block; font: 400 15px/1.5 var(--sans); color: var(--ink-2); }
  .fw-loop .ll-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .fw-loop .ll-tabs button { font: 600 12.5px/1 var(--sans); padding: 8px 11px; border: 1px solid var(--rule); background: var(--paper); color: var(--ink); cursor: pointer; }
  .fw-loop .ll-tabs button[aria-selected='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .fw-loop.ll-js .ll-seg { stroke: var(--rule); }
  .fw-loop.ll-js .ll-seg.on { stroke: var(--band); }
  .fw-loop.ll-js .ll-seg.on.cur { stroke: var(--kicker); }
  .fw-loop.ll-js .ll-step { display: none; }
  .fw-loop.ll-js .ll-step.cur { display: block; }
  .fw-loop.ll-js .ll-step .ll-h { font-size: 1.4rem; margin-bottom: 4px; }
  @media (prefers-reduced-motion: no-preference) {
    .fw-loop.ll-js .ll-step.cur { animation: ll-in 0.45s ease-out both; }
    @keyframes ll-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const root of document.querySelectorAll<HTMLElement>('[data-listening-loop]')) {
    const segs = [...root.querySelectorAll<SVGPathElement>('.ll-seg')];
    const steps = [...root.querySelectorAll<HTMLElement>('.ll-step')];
    const tabs = root.querySelector<HTMLElement>('.ll-tabs')!;
    const btns = [...tabs.querySelectorAll<HTMLButtonElement>('button')];
    root.classList.add('ll-js');
    tabs.hidden = false;
    let cur = 0, timer: number | undefined;
    const show = (i: number) => {
      cur = i;
      segs.forEach((s, k) => { s.classList.toggle('on', k <= i); s.classList.toggle('cur', k === i); });
      steps.forEach((s, k) => s.classList.toggle('cur', k === i));
      btns.forEach((b, k) => b.setAttribute('aria-selected', String(k === i)));
    };
    const stop = () => { if (timer) clearInterval(timer); timer = undefined; };
    btns.forEach((b, i) => b.addEventListener('click', () => { stop(); show(i); }));
    show(0);
    if (reduce || !('IntersectionObserver' in window)) continue;
    const io = new IntersectionObserver((es) => {
      if (!es.some((e) => e.isIntersecting)) return;
      io.disconnect();
      timer = window.setInterval(() => show((cur + 1) % steps.length), 3200);
    }, { threshold: 0.4 });
    io.observe(root);
  }
</script>
