---
// Compare hub: platform reviews, scored by one published method. Side-by-side comparisons are
// drawn from the technology directory as it fills (docs/directory.md). No ads on this page.
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import HowWeEvaluate from '../components/home/HowWeEvaluate.astro';
import { NAV, SECTIONS } from '../site.config';
import { getArticles } from '../lib/articles';
import categories from '../data/directory/categories.json';
const nav = NAV.find((n) => n.key === 'compare')!;
const reviews = await getArticles('reviews');
const planned = categories.filter((c) => c.comparison).sort((a, b) => a.order - b.order);
---
<Base title={nav.label} description={`${nav.note}. ${SECTIONS.reviews.blurb}`} current="compare">
  <div class="wrap">
    <header class="page-head"><h1>{nav.label}</h1><p>{nav.note}. {SECTIONS.reviews.blurb}</p></header>
    <section aria-labelledby="r-h">
      <div class="section-head" style="margin-top:0"><h2 id="r-h">Platform reviews</h2><a href="/reviews/">All reviews →</a></div>
      {reviews.length ? <div class="grid-3">{reviews.map((a) => <ArticleCard article={a} />)}</div>
        : <div class="empty"><h2>The first reviews are in testing</h2><p>We build a real course on each platform before we score it. <a href="/newsletter/">Hear when they land.</a></p></div>}
    </section>
    <section aria-labelledby="c-h">
      <div class="section-head"><h2 id="c-h">Comparisons in the works</h2></div>
      <ul class="cat-grid">{planned.map((c) => <li><b>{c.name}</b><span>{c.description}</span></li>)}</ul>
    </section>
  </div>
  <HowWeEvaluate />
</Base>
