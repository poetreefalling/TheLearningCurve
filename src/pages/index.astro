---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import AdSlot from '../components/AdSlot.astro';
import SponsoredCard from '../components/SponsoredCard.astro';
import HowWeEvaluate from '../components/home/HowWeEvaluate.astro';
import IntelligencePreview from '../components/home/IntelligencePreview.astro';
import ReportCard from '../components/report/ReportCard.astro';
import { REPORT } from '../data/reports/ai-tools-for-learning-design';
import { SITE } from '../site.config';
import { getArticles } from '../lib/articles';
import { pickAd } from '../lib/ads';

const all = await getArticles();
const lead = all.find((a) => a.data.featured) ?? all[0];
const others = all.filter((a) => a !== lead);

// The grid under the lead: two rows of three. In the second row a sponsored card and a medium
// rectangle take the last two cells when they're booked; the articles they displace move down.
const hasCard = !!pickAd('card', 'home');
const hasRect = !!pickAd('rectangle', 'home');
// The free field guide takes the last cell of the first row while REPORT.homeCard is on.
const promo = REPORT.homeCard;
const row1 = others.slice(0, 3 - Number(promo));
const row2 = others.slice(row1.length, row1.length + 3 - Number(hasCard) - Number(hasRect));
const shown = new Set([lead, ...row1, ...row2].filter(Boolean));
const library = all.filter((a) => a.data.section === 'library' && !shown.has(a)).slice(0, 4);
library.forEach((a) => shown.add(a));
const river = others.filter((a) => !shown.has(a)).slice(0, 12);

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, potentialAction: { '@type': 'SearchAction', target: `${SITE.url}/search/?q={query}`, 'query-input': 'required name=query' } },
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: SITE.url, logo: `${SITE.url}/icon-512.png`, founder: { '@type': 'Person', name: SITE.author.name } },
];
---

<Base title={SITE.name} description={SITE.description} jsonLd={jsonLd} ads>
  {lead && (
    <section class="band band-lead" aria-label="Top story">
      <div class="wrap"><ArticleCard article={lead} variant="feature" eager /></div>
    </section>
  )}

  <div class="wrap">
    {!lead && (
      <div class="empty">
        <h2>The first issue is on its way</h2>
        <p>
          Twice a day from now on: the research on how people learn, practical course design, and honest reviews
          of the platforms. <a href="/about/">About the publication</a>.
        </p>
      </div>
    )}

    {row1.length > 0 && (
      <section class="home-grid" aria-label="Latest">
        {row1.map((a) => <ArticleCard article={a} />)}
        {promo && <ReportCard />}
      </section>
    )}

    <AdSlot unit="billboard" page="home" class="ad-band" />

    {(row2.length > 0 || hasCard || hasRect) && (
      <section class="home-grid home-grid-2" aria-label="More stories">
        {row2.map((a) => <ArticleCard article={a} />)}
        <SponsoredCard />
        <AdSlot unit="rectangle" page="home" class="ad-cell" />
      </section>
    )}
  </div>

  <HowWeEvaluate />

  <div class="wrap">
    <IntelligencePreview />

    {library.length > 0 && (
      <section aria-labelledby="lib-h">
        <div class="section-head"><h2 id="lib-h">From the Library</h2><a href="/library/">The full library →</a></div>
        <div class="grid-4">{library.map((a) => <ArticleCard article={a} showStandfirst={false} />)}</div>
      </section>
    )}

    {river.length > 0 && (
      <section aria-labelledby="latest-h">
        <div class="section-head"><h2 id="latest-h">Latest</h2></div>
        <ul class="river">{river.map((a) => <li><ArticleCard article={a} variant="river" /></li>)}</ul>
      </section>
    )}

  </div>

  <section class="newsletter-band band" aria-labelledby="nl-h">
    <div class="wrap newsletter-inner">
      <div>
        <h2 id="nl-h">The month in learning design</h2>
        <p>New research, what it means for your course, and one platform worth a look. Once a month.</p>
      </div>
      <div><NewsletterForm placement="home-band" /></div>
    </div>
  </section>
</Base>
