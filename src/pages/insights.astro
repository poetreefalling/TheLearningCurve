---
import SectionAbout from '../components/SectionAbout.astro';
// Insights hub: news, trends and editorial. Today that's the Trends section.
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { NAV, SECTIONS } from '../site.config';
import { getArticles } from '../lib/articles';
import { getCuriosities, curiosityUrl, slideSrc, CORNER } from '../lib/curiosity';
const corner = (await getCuriosities()).slice(0, 4);
const nav = NAV.find((n) => n.key === 'insights')!;
const items = await getArticles('trends');
const [lead, ...rest] = items;
---
<Base title={nav.label} description={`${nav.note}. ${SECTIONS.trends.blurb}`} current="insights">
  <div class="wrap">
    <header class="page-head"><h1>{nav.label}</h1><p>{nav.note}. {SECTIONS.trends.blurb}</p></header>
    {!lead && <div class="empty"><h2>Coming soon</h2><p>The first pieces are on their way. <a href="/newsletter/">Get them by email.</a></p></div>}
    {lead && (
      <div class="lead-grid" style="padding-top:0">
        <ArticleCard article={lead} variant="lead" eager />
        <div class="lead-side">{rest.slice(0, 3).map((a) => <ArticleCard article={a} variant="text" />)}</div>
      </div>
    )}
    {rest.length > 3 && (
      <section aria-labelledby="more-h">
        <div class="section-head"><h2 id="more-h">More trends</h2><a href="/trends/">All trends →</a></div>
        <ul class="river">{rest.slice(3, 23).map((a) => <li><ArticleCard article={a} variant="river" /></li>)}</ul>
      </section>
    )}
    <section class="cc-band" aria-labelledby="cc-band-h">
      <div class="section-head"><h2 id="cc-band-h">{CORNER.name}</h2><a href="/curiosity/">All of {CORNER.name} →</a></div>
      <p class="cc-band-blurb">{CORNER.blurb}</p>
      {corner.length > 0 ? (
        <ul class="cc-band-grid">{corner.map((c) => (
          <li><a href={curiosityUrl(c)}><img src={slideSrc(c, 0)} alt="" width="1080" height="1350" loading="lazy" decoding="async" /><span class="cc-band-series">{c.data.series}</span><span class="cc-band-title">{c.data.title}</span></a></li>
        ))}</ul>
      ) : <p class="cc-band-soon">The first puzzle lands soon. <a href="/curiosity/">Take a look</a>.</p>}
    </section>
    <SectionAbout page="insights" />
  </div>
</Base>
<style>
  .cc-band { margin: 48px 0; }
  .cc-band-blurb { font-family: var(--serif); color: var(--ink-2); max-width: 640px; margin: 0 0 20px; }
  .cc-band-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 24px; }
  .cc-band-grid a { display: flex; flex-direction: column; gap: 6px; color: var(--ink); text-decoration: none; }
  .cc-band-grid img { width: 100%; height: auto; aspect-ratio: 4 / 5; border-radius: 2px; margin-bottom: 6px; }
  .cc-band-series { font: 700 11.5px/1.2 var(--label); letter-spacing: 0.1em; text-transform: uppercase; color: var(--kicker); }
  .cc-band-title { font-family: var(--display); font-weight: 750; font-size: 1.1rem; line-height: 1.2; }
  .cc-band-grid a:hover .cc-band-title { text-decoration: underline; }
  .cc-band-soon { font: 400 15px/1.5 var(--sans); }
</style>
