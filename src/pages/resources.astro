---
import SectionAbout from '../components/SectionAbout.astro';
// Resources hub: free field guides and toolkits (reports, the course design kit), the Guides and the Library (one page per learning principle).
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ReportCard from '../components/report/ReportCard.astro';
import KitCard from '../components/kit/KitCard.astro';
import { REPORT as TEACHER } from '../data/reports/classroom-to-instructional-design';
import { NAV, SECTIONS } from '../site.config';
import { getArticles } from '../lib/articles';
const nav = NAV.find((n) => n.key === 'resources')!;
const library = await getArticles('library');
const guides = await getArticles('guides');
const teacherGuide = { slug: TEACHER.slug, pages: TEACHER.pages, kicker: 'Free career guide', title: 'From classroom to instructional design', blurb: 'For teachers moving into instructional design: what employers ask for, what already transfers, and a six-step plan.', images: ['page-plan', 'page-translate', 'page-evidence', 'cover'] as [string, string, string, string] };
---
<Base title={nav.label} description={`${nav.note}: practical course design and the research on how people learn.`} current="resources">
  <div class="wrap">
    <header class="page-head"><h1>{nav.label}</h1><p>{nav.note}: practical course design, and the research on how people learn.</p></header>
    <section aria-labelledby="r-h">
      <div class="section-head" style="margin-top:0"><h2 id="r-h">Free field guides and toolkits</h2></div>
      <p class="hub-blurb">In-depth, downloadable guides and templates for learning designers, L&amp;D leaders, educators and people moving into the field. Free, with every source listed.</p>
      <div class="grid-3"><KitCard /><ReportCard wide /><ReportCard wide guide={teacherGuide} /></div>
      <a class="tg-banner" href={`/reports/${TEACHER.slug}/`}>
        <picture>
          <source media="(prefers-reduced-motion: reduce) and (max-width: 640px)" srcset="/images/reports/classroom-to-instructional-design/banner-tall-still.webp" width="900" height="1125" />
          <source media="(prefers-reduced-motion: reduce)" srcset="/images/reports/classroom-to-instructional-design/banner-wide-still.webp" />
          <source media="(max-width: 640px)" srcset="/images/reports/classroom-to-instructional-design/banner-tall.webp" width="900" height="1125" />
          <img src="/images/reports/classroom-to-instructional-design/banner-wide.webp" width="1800" height="600" loading="lazy" decoding="async" alt="Free career guide for teachers: From classroom to instructional design. Classroom work renamed in employers' words, such as planned units and sequences of lessons becoming course mapping and sequencing. Get the free guide." />
        </picture>
      </a>
    </section>
    <section aria-labelledby="g-h">
      <div class="section-head"><h2 id="g-h">{SECTIONS.guides.label}</h2><a href="/guides/">All guides →</a></div>
      <p class="hub-blurb">{SECTIONS.guides.blurb}</p>
      {guides.length ? <div class="grid-3">{guides.slice(0, 6).map((a) => <ArticleCard article={a} />)}</div> : <p class="meta">The first guides are on their way.</p>}
    </section>
    <section aria-labelledby="l-h">
      <div class="section-head"><h2 id="l-h">The {SECTIONS.library.label}</h2><a href="/library/">The full library →</a></div>
      <p class="hub-blurb">{SECTIONS.library.blurb}</p>
      {library.length ? <div class="grid-4">{library.slice(0, 8).map((a) => <ArticleCard article={a} showStandfirst={false} />)}</div> : <p class="meta">The first library pages are on their way.</p>}
    </section>
    <SectionAbout page="resources" />
  </div>
</Base>
